# Cloudflare Pages env vars (set in dashboard) override these placeholders at build time.
VITE_BACKEND_WS=wss://your-oracle-domain
VITE_BACKEND_HTTP=https://your-oracle-domain
# Leave VITE_DEMO_PIN blank in the file so the placeholder doesn't leak in the repo;
# set the real value in Cloudflare Pages → Settings → Environment variables (Production).
VITE_DEMO_PIN=
