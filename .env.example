# Backend env. Copy to .env at repo root and fill in.
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2
OPENAI_REALTIME_URL=wss://api.openai.com/v1/realtime
TTS_VOICE=alloy
SESSION_MAX_DURATION_S=300
DEBUG=false
# Comma-separated list of allowed CORS origins. Use "*" for dev only.
# Example for prod: ALLOWED_ORIGINS=https://lumo.shreyas.space
ALLOWED_ORIGINS=*
