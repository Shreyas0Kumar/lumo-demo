OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2
OPENAI_REALTIME_URL=wss://api.openai.com/v1/realtime
TTS_VOICE=alloy
SESSION_MAX_DURATION_S=300
# Max sessions a single IP can start per day (cost guard). 0 disables the cap.
SESSION_CAP_PER_IP_PER_DAY=5
DEBUG=false
# Comma-separated list of allowed CORS origins. Use "*" for dev only.
# Example: ALLOWED_ORIGINS=https://lumo-demo.pages.dev
ALLOWED_ORIGINS=*
